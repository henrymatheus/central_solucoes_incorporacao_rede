{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Central de Incorporação",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\manage.py",
      "args": ["runserver"],
      "django": true,
