CSIR_DEBUG=1
CSIR_SECRET_KEY=change-this-local-development-key
CSIR_ALLOWED_HOSTS=127.0.0.1,localhost
CSIR_MEDIA_ROOT=media

# SQLite is the local default. For PostgreSQL configure an installed Django backend.
CSIR_DB_ENGINE=django.db.backends.sqlite3
CSIR_DB_NAME=db.sqlite3

# Snowflake credentials are intentionally not included. Configure only in a
# protected environment after access has been approved.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=WH_EQTLINFO
SNOWFLAKE_DATABASE=EQTLINFO_RAW
